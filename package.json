{
  "name": "rd-browser",
  "version": "1.0.0",
  "description": "Real-Debrid Browser Backend",
  "type": "module",
  "main": "debug/main.js",
  "scripts": {
    "start": "npm run start-dev",
    "dev": "npm run start-dev",
    "start-dev": "tsx build/build.ts dev",
    "start-prod": "tsx build/build.ts prod",
    "build-dev": "tsx build/build.ts dev-only",
    "build-prod": "tsx build/build.ts prod-only",
    "generate-api": "tsx build/generator.ts"
  },
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#lib/*": "./src/lib/*.ts",
    "#hooks/*": "./src/hooks/*.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@videojs/react": "^10.0.0-beta.24",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.16.0",
    "material-symbols": "^0.44.9",
    "mini.css": "^3.0.1",
    "module-alias": "^2.3.4",
    "preact": "^10.29.2",
    "radix-ui": "^1.4.3",
    "sqlite3": "^6.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.5",
    "@types/electron": "^1.4.38",
    "@types/node": "^25.9.1",
    "electron": "^42.1.0",
    "esbuild": "^0.28.0",
    "glob": "^13.0.6",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.14"
  }
}
